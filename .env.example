# Copy to .env and fill in values for local development.
# Never commit .env to version control.

# ── Database ─────────────────────────────────────────────────────────────────
# Production (AWS RDS PostgreSQL):
# RAPIDQCMS_DB_URL=postgresql://user:password@your-rds-endpoint.rds.amazonaws.com/rapidqcms

# Local dev (SQLite, default — omit to use this):
# RAPIDQCMS_DB_URL=sqlite:///data/rapidqcms.db

# ── Storage ───────────────────────────────────────────────────────────────────
# Production (S3):
# RAPIDQCMS_STORAGE_BACKEND=s3
# RAPIDQCMS_S3_BUCKET=czbiohub-rapidqcms
# RAPIDQCMS_S3_PREFIX=rapidqcms

# Local dev (filesystem, default — omit to use this):
# RAPIDQCMS_STORAGE_BACKEND=local
# RAPIDQCMS_LOCAL_STORAGE_PATH=data/storage

# ── Notifications ─────────────────────────────────────────────────────────────
# RAPIDQCMS_SLACK_BOT_TOKEN=xoxb-...
# RAPIDQCMS_SLACK_CHANNEL=#mass-spec-qc

# ── Auth (Okta SSO — Phase 4) ─────────────────────────────────────────────────
# RAPIDQCMS_OKTA_DOMAIN=czbiohub.okta.com
# RAPIDQCMS_OKTA_CLIENT_ID=...
# RAPIDQCMS_OKTA_CLIENT_SECRET=...

# ── QC module config (optional override) ─────────────────────────────────────
# RAPIDQCMS_QC_MODULES_CONFIG=/path/to/custom/qc_modules.toml
