Bootstrap: docker
From: mcr.microsoft.com/dotnet/runtime:8.0-noble

%labels
    Author Anthony Goering
    Description MS-DIAL Console for LC-MS metabolomics feature detection
    Version 0.1.0

%post
    apt-get update && \
    apt-get install -y --no-install-recommends python3 && \
    rm -rf /var/lib/apt/lists/*

    mkdir -p /opt/msdial

%files
    MsdialConsoleApp_linux-x64/ /opt/msdial/

%post
    chmod +x /opt/msdial/MsdialConsoleApp

%environment
    export PATH="/opt/msdial:$PATH"

%runscript
    exec MsdialConsoleApp "$@"

%test
    MsdialConsoleApp 2>&1 | head -1 || true
    python3 --version
